listen 443;
workers 2;
logfile var/log/barebones-reverse-proxy/proxy.log;

security {
    // Proxy protocol v1 header parsing behind a trusted upstream load balancer
    proxy_protocol off;
    // trusted_upstream 10.0.0.1;
    timeout 200;

    // Active defense & rate-limiting settings
    max_tls_failures 5;    // Blacklist IP if > 5 TLS handshake failures occur within 60s
    ban_duration 3600;     // Duration in seconds (3600 = 1 hour) that an IP remains blacklisted
    rate_limit_rpm 300;    // Max HTTP requests per minute per IP before returning 429 Too Many Requests (set 0 to disable)
}

cert dashboard.home {
    cert /etc/ssl/dashboard/cert.pem;
    key /etc/ssl/dashboard/key.pem;
}

route https://dashboard.home/ http://localhost:3001/;