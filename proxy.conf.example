listen 443;
workers 2;
logfile var/log/barebones-reverse-proxy/proxy.log;

// Upstream Error Interception (Default: off)
// Discards 4xx/5xx error bodies from upstream backends and returns built-in retro error pages
intercept_errors on;

// High-Performance In-Memory LRU Static Asset Cache
cache {
    enabled on;             // Enable/disable static asset caching (default: off)
    max_capacity_mb 64;     // Maximum RAM capacity allocated for LRU cache (default: 64MB)
    max_file_size_mb 2;     // Max file size of an individual cached asset (default: 2MB)
    default_ttl_sec 300;    // Time-To-Live in seconds (default: 300s / 5 minutes)
}

security {
    // Proxy protocol v1 header parsing behind a trusted upstream load balancer
    proxy_protocol off;
    // trusted_upstream 10.0.0.1;
    timeout 200;

    // Active defense & rate-limiting settings
    max_tls_failures 5;    // Blacklist IP if > 5 TLS handshake failures occur within 60s
    ban_duration 3600;     // Duration in seconds (3600 = 1 hour) that an IP remains blacklisted
    rate_limit_rpm 300;    // Max HTTP requests per minute per IP before returning 429 Too Many Requests (set 0 to disable)

    // Payload & Header size limits (DoS Protection)
    max_body_size 10M;     // Max HTTP request payload size (e.g. 10M, 500K, 1G or raw bytes; default: 10M)
    max_header_size 64K;   // Max HTTP request headers size (e.g. 64K, 128K or raw bytes; default: 64K)

    // Forward Authentication Provider (Authelia / Authentik / OAuth2-Proxy)
    forward_auth http://localhost:9091/api/verify;
}

// Protected Route (Requires TLS cert/key and authentication via forward_auth provider)
route https://dashboard.home/ {
    upstream http://localhost:3001/;
    auth on;
    cert /etc/ssl/dashboard/cert.pem;
    key /etc/ssl/dashboard/key.pem;
    intercept_errors on; // Override per-route to intercept upstream errors
}

// Public Route (Omit auth directive or set auth off)
// route http://public.home/ {
//     upstream http://localhost:4000/;
//     auth off;
//     intercept_errors off; // Allow raw 4xx/5xx responses from upstream backend
// }